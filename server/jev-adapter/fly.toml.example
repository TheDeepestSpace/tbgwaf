app = "replace-with-your-tbgwaf-jev-preview-app"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "8787"
  TBGWAF_JEV_ALLOWED_ORIGINS = "https://thedeepestspace.github.io"
  TBGWAF_JEV_RATE_PER_MINUTE = "12"
  TBGWAF_JEV_DAILY_LIMIT = "500"
  TBGWAF_JEV_MAX_CONCURRENCY = "2"
  TBGWAF_JEV_TIMEOUT_MS = "8000"
  TBGWAF_JEV_RETRIES = "1"
  TBGWAF_JEV_TRUST_PROXY = "1"

[http_service]
  internal_port = 8787
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    method = "GET"
    path = "/health"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
